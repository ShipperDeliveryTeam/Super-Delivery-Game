from __future__ import annotations

import math
from typing import Any

import pygame


class DirectionalShipper:
    """
    DirectionalShipper compatibility class for Super Delivery Game.

    This version keeps the current game_manager.py compatible:
    - set_direction_from_delta(dx, dy)
    - update_smooth(dt)
    - update(dt)
    - move_grid(dx, dy, max_cols, max_rows, min_y=0)
    - move_to_grid(pos)
    - set_grid_pos(pos)
    - set_grid_position(pos)
    - teleport_to_grid(pos)
    - render_pos
    - grid_pos

    Movement rule:
    - Only one adjacent grid cell per move.
    - No long-distance teleport during normal movement.
    """

    def __init__(self, name="Shipper", grid_pos=(0, 0), sprites=None, *args, **kwargs):
        self.name = name
        self.sprites = sprites or {}

        self.tile_size = int(kwargs.get("tile_size", 32))
        self.color = kwargs.get("color", (255, 200, 40))
        self.algorithm = kwargs.get("algorithm", "")
        self.speed_px = float(kwargs.get("speed", kwargs.get("speed_px", 105.0)))

        # Compatibility with older constructor call styles:
        # DirectionalShipper(name, pos, sprites, color, algorithm, tile_size)
        # DirectionalShipper(name, pos, sprites, tile_size, color, algorithm)
        for arg in args:
            if isinstance(arg, tuple) and len(arg) >= 3:
                self.color = arg[:3]
            elif isinstance(arg, str):
                self.algorithm = arg
            elif isinstance(arg, (int, float)):
                if int(arg) >= 16:
                    self.tile_size = int(arg)
                else:
                    self.speed_px = float(arg)

        self.speed_px = max(45.0, min(float(self.speed_px), 125.0))

        self._grid_pos = (int(grid_pos[0]), int(grid_pos[1]))
        self.target_grid_pos = self._grid_pos

        self.pixel_x = float(self._grid_pos[0] * self.tile_size)
        self.pixel_y = float(self._grid_pos[1] * self.tile_size)

        self.direction = "down"
        self.is_moving = False

        self.money = int(kwargs.get("money", 0))
        self.orders = int(kwargs.get("orders", 0))
        self.expanded_nodes = int(kwargs.get("expanded_nodes", 0))

    # =====================================================
    # Position properties
    # =====================================================
    @property
    def grid_pos(self):
        return self._grid_pos

    @grid_pos.setter
    def grid_pos(self, value):
        self.set_grid_position(value)

    @property
    def grid_x(self):
        return self._grid_pos[0]

    @property
    def grid_y(self):
        return self._grid_pos[1]

    @property
    def render_pos(self):
        # Return render position in grid units. Existing game_manager uses this.
        return (self.pixel_x / self.tile_size, self.pixel_y / self.tile_size)

    @property
    def pixel_pos(self):
        return (self.pixel_x, self.pixel_y)

    @property
    def x(self):
        return self.pixel_x

    @property
    def y(self):
        return self.pixel_y

    # =====================================================
    # Direction helpers
    # =====================================================
    def set_direction_from_delta(self, dx, dy):
        """
        Required by current game_manager.py.
        """
        dx = int(dx)
        dy = int(dy)

        if dx > 0:
            self.direction = "right"
        elif dx < 0:
            self.direction = "left"
        elif dy > 0:
            self.direction = "down"
        elif dy < 0:
            self.direction = "up"

    def _set_direction(self, dx, dy):
        self.set_direction_from_delta(dx, dy)

    # =====================================================
    # Position setters
    # =====================================================
    def set_grid_position(self, pos):
        pos = (int(pos[0]), int(pos[1]))
        self._grid_pos = pos
        self.target_grid_pos = pos
        self.pixel_x = float(pos[0] * self.tile_size)
        self.pixel_y = float(pos[1] * self.tile_size)
        self.is_moving = False

    def set_grid_pos(self, pos):
        self.set_grid_position(pos)

    def teleport_to_grid(self, pos):
        self.set_grid_position(pos)

    def snap_to_grid(self):
        self.set_grid_position(self._grid_pos)

    def stop(self):
        self.is_moving = False
        self.target_grid_pos = self._grid_pos
        self.pixel_x = float(self._grid_pos[0] * self.tile_size)
        self.pixel_y = float(self._grid_pos[1] * self.tile_size)

    # =====================================================
    # Movement
    # =====================================================
    def move_grid(self, dx, dy, max_cols, max_rows, min_y=0):
        """
        Move one cell by delta. Used by keyboard movement.
        """
        dx = int(dx)
        dy = int(dy)

        if abs(dx) + abs(dy) != 1:
            return False

        if self.is_moving:
            return False

        x, y = self._grid_pos
        nx = max(0, min(int(max_cols) - 1, x + dx))
        ny = max(int(min_y), min(int(max_rows) - 1, y + dy))

        if (nx, ny) == self._grid_pos:
            return False

        return self.move_to_grid((nx, ny))

    def move_to_grid(self, pos):
        """
        Move to one adjacent grid cell.
        """
        pos = (int(pos[0]), int(pos[1]))

        if self.is_moving:
            return False

        dx = pos[0] - self._grid_pos[0]
        dy = pos[1] - self._grid_pos[1]

        # Prevent teleport / wall crossing.
        if abs(dx) + abs(dy) != 1:
            return False

        self.set_direction_from_delta(dx, dy)
        self.target_grid_pos = pos
        self.is_moving = True
        return True

    # Compatibility aliases
    def move_to(self, pos):
        return self.move_to_grid(pos)

    def start_move_to(self, pos):
        return self.move_to_grid(pos)

    def update(self, dt):
        if not self.is_moving:
            return

        target_x = self.target_grid_pos[0] * self.tile_size
        target_y = self.target_grid_pos[1] * self.tile_size

        dx = target_x - self.pixel_x
        dy = target_y - self.pixel_y
        dist = math.hypot(dx, dy)

        step = self.speed_px * float(dt)

        if dist <= step or dist <= 0.01:
            self.pixel_x = float(target_x)
            self.pixel_y = float(target_y)
            self._grid_pos = self.target_grid_pos
            self.is_moving = False
            return

        self.pixel_x += dx / dist * step
        self.pixel_y += dy / dist * step

    def update_smooth(self, dt):
        """
        Required by current game_manager.py.
        """
        self.update(dt)

    # =====================================================
    # Drawing
    # =====================================================
    def draw(self, screen, *args, **kwargs):
        sprite = self._current_sprite()

        x = int(round(self.pixel_x))
        y = int(round(self.pixel_y))

        if sprite:
            rect = sprite.get_rect()
            rect.center = (x + self.tile_size // 2, y + self.tile_size // 2)
            screen.blit(sprite, rect)
            return

        rect = pygame.Rect(x + 4, y + 4, self.tile_size - 8, self.tile_size - 8)
        pygame.draw.ellipse(screen, self.color, rect)
        pygame.draw.ellipse(screen, (20, 20, 20), rect, width=2)

    def _current_sprite(self):
        if self.direction in self.sprites:
            return self.sprites[self.direction]

        if "idle" in self.sprites:
            return self.sprites["idle"]

        if "right" in self.sprites:
            return self.sprites["right"]

        if "down" in self.sprites:
            return self.sprites["down"]

        return None
