from __future__ import annotations

import math
from typing import Any

import pygame


class DirectionalShipper:
    """
    Shipper di chuyển mượt theo grid.

    Chống lỗi bay xuyên tường:
    - move_to_grid chỉ nhận bước đi kề cạnh 1 ô.
    - Nếu code đưa target quá xa, nhân vật không teleport.
    """

    def __init__(
        self,
        name: str = "Shipper",
        grid_pos: tuple[int, int] = (0, 0),
        sprites: dict[str, pygame.Surface] | None = None,
        color: tuple[int, int, int] = (255, 200, 40),
        algorithm: str = "",
        tile_size: int = 32,
        speed_px: float = 115.0,
        **kwargs: Any,
    ):
        self.name = name
        self.grid_pos = tuple(grid_pos)
        self.target_grid_pos = tuple(grid_pos)

        self.tile_size = tile_size
        self.pixel_x = float(self.grid_pos[0] * tile_size)
        self.pixel_y = float(self.grid_pos[1] * tile_size)

        self.speed_px = float(kwargs.get("speed", speed_px))
        self.speed_px = min(self.speed_px, 145.0)

        self.sprites = sprites or {}
        self.color = color
        self.algorithm = algorithm

        self.money = int(kwargs.get("money", 0))
        self.orders = int(kwargs.get("orders", 0))
        self.expanded_nodes = int(kwargs.get("expanded_nodes", 0))

        self.direction = "down"
        self.is_moving = False

    @property
    def pixel_pos(self) -> tuple[float, float]:
        return (self.pixel_x, self.pixel_y)

    def set_grid_position(self, pos: tuple[int, int]) -> None:
        self.grid_pos = tuple(pos)
        self.target_grid_pos = tuple(pos)
        self.pixel_x = float(pos[0] * self.tile_size)
        self.pixel_y = float(pos[1] * self.tile_size)
        self.is_moving = False

    def set_grid_pos(self, pos: tuple[int, int]) -> None:
        self.set_grid_position(pos)

    def teleport_to_grid(self, pos: tuple[int, int]) -> None:
        self.set_grid_position(pos)

    def move_to_grid(self, pos: tuple[int, int]) -> bool:
        pos = tuple(pos)

        if self.is_moving:
            return False

        dx = pos[0] - self.grid_pos[0]
        dy = pos[1] - self.grid_pos[1]

        # Chặn teleport / bay xuyên tường:
        # chỉ cho di chuyển 1 ô theo 4 hướng.
        if abs(dx) + abs(dy) != 1:
            return False

        if dx > 0:
            self.direction = "right"
        elif dx < 0:
            self.direction = "left"
        elif dy > 0:
            self.direction = "down"
        elif dy < 0:
            self.direction = "up"

        self.target_grid_pos = pos
        self.is_moving = True
        return True

    def update(self, dt: float) -> None:
        if not self.is_moving:
            return

        target_x = self.target_grid_pos[0] * self.tile_size
        target_y = self.target_grid_pos[1] * self.tile_size

        dx = target_x - self.pixel_x
        dy = target_y - self.pixel_y
        dist = math.hypot(dx, dy)

        step = self.speed_px * dt

        if dist <= step or dist <= 0.01:
            self.pixel_x = float(target_x)
            self.pixel_y = float(target_y)
            self.grid_pos = self.target_grid_pos
            self.is_moving = False
            return

        self.pixel_x += dx / dist * step
        self.pixel_y += dy / dist * step

    def draw(self, screen: pygame.Surface, *args: Any, **kwargs: Any) -> None:
        sprite = self._current_sprite()
        x = int(round(self.pixel_x))
        y = int(round(self.pixel_y))

        if sprite:
            rect = sprite.get_rect()
            rect.center = (x + self.tile_size // 2, y + self.tile_size // 2)
            screen.blit(sprite, rect)
            return

        rect = pygame.Rect(x + 4, y + 4, self.tile_size - 8, self.tile_size - 8)
        pygame.draw.ellipse(screen, self.color, rect)
        pygame.draw.ellipse(screen, (20, 20, 20), rect, width=2)

    def _current_sprite(self) -> pygame.Surface | None:
        if self.direction in self.sprites:
            return self.sprites[self.direction]

        if "idle" in self.sprites:
            return self.sprites["idle"]

        if "right" in self.sprites:
            return self.sprites["right"]

        return None
