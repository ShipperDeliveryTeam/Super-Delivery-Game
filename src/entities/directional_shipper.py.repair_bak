from __future__ import annotations

from typing import Dict, Tuple

import pygame


class DirectionalShipper:
    def __init__(
        self,
        name: str,
        grid_pos: Tuple[int, int],
        sprites: Dict[str, pygame.Surface],
        tile_size: int = 32,
        speed_step_delay: float = 0.12,
    ):
        self.name = name
        self.grid_x = int(grid_pos[0])
        self.grid_y = int(grid_pos[1])
        self.sprites = sprites
        self.tile_size = tile_size
        self.direction = "down"
        self.money = 0
        self.orders = 0
        self.speed_step_delay = speed_step_delay
        self._move_timer = 0.0

    @property
    def grid_pos(self) -> Tuple[int, int]:
        return self.grid_x, self.grid_y

    def set_grid_pos(self, pos: Tuple[int, int]) -> None:
        self.grid_x = int(pos[0])
        self.grid_y = int(pos[1])

    def move_grid(self, dx: int, dy: int, max_cols: int, max_rows: int, min_y: int = 1) -> None:
        if dx < 0:
            self.direction = "left"
        elif dx > 0:
            self.direction = "right"
        elif dy < 0:
            self.direction = "up"
        elif dy > 0:
            self.direction = "down"

        self.grid_x = max(0, min(max_cols - 1, self.grid_x + dx))
        self.grid_y = max(min_y, min(max_rows - 1, self.grid_y + dy))

    def draw(self, screen: pygame.Surface, camera_offset: Tuple[int, int] = (0, 0)) -> None:
        sprite = self.sprites.get(self.direction) or self.sprites.get("idle")
        x = self.grid_x * self.tile_size - camera_offset[0]
        y = self.grid_y * self.tile_size - camera_offset[1]
        screen.blit(sprite, (x, y))
